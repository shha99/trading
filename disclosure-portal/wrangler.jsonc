// Cloudflare Worker 설정. 대시보드의 Worker 이름이 아래 name과 같아야 GitHub 연결 배포가 된다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "disclosure-portal",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 비밀번호 잠금이 정적 파일(화면)에도 걸리도록 모든 요청을 Worker가 먼저 받는다
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
