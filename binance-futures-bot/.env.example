# === 바이낸스 계정 (절대 커밋 금지 — 이 파일은 예시일 뿐, 실제 값은 .env에) ===
# 테스트넷 키는 https://testnet.binancefuture.com 에서 발급받는다.
# 실계좌 키를 쓸 경우, API 키 권한은 "선물 거래"만 켜고 "출금"은 반드시 끌 것.
# 가능하면 IP 제한(허용 IP만 접근)도 걸어둘 것.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# true(기본) = 테스트넷, false = 실계좌. false로 바꾸는 건 리스크를 완전히
# 이해한 뒤에만 할 것.
BINANCE_TESTNET=true

# === 대상 심볼/시간대 ===
SYMBOLS=BTCUSDT,ETHUSDT
TIMEFRAMES=15m,1h,4h,1d

# === 전략 파라미터 (기본값 = 친구분이 검증한 BTC 1시간봉 규칙) ===
TREND_EMA_PERIOD=200
KELTNER_EMA_PERIOD=20
KELTNER_ATR_PERIOD=10
KELTNER_ATR_MULT=2.0
STOP_ATR_MULT=2.0
TARGET_ATR_MULT=4.0
TIME_STOP_DAYS=3

# === 자동매매 게이트 (기본 전부 꺼짐/안전 쪽) ===
# 명시적으로 true로 바꿔야 주문이 나간다.
AUTO_TRADE_ENABLED=false
# "심볼:시간대" 콤마 구분. 검증된 것은 BTCUSDT:1h 뿐 — 다른 조합은 친구분
# 자료 기준으로 아직 검증되지 않았거나(다른 시간대) 손실이었음(ETH 1h).
AUTO_TRADE_WHITELIST=
# 진입 1건당 감수할 손실 금액(USDT). 수량 = 이 값 / (진입가-손절가).
RISK_PER_TRADE_USDT=10
# 리스크 사이징 모드. fixed(기본) = 매 거래 RISK_PER_TRADE_USDT 고정 금액.
# percent_balance = 매 거래 직전 가용잔고의 RISK_PERCENT_OF_BALANCE(%)를
# 다시 계산해서 건다 - 잔고가 늘면 리스크도 같이 커지는 복리형. 잔고 조회
# 실패/0 이하면 자동으로 RISK_PER_TRADE_USDT로 폴백한다.
# combo_weighted = wick 전용(켈트너는 fixed처럼 동작) - 가용잔고를 조합별
# 신뢰도 가중치(WICK_RELIABILITY_WEIGHTING_ENABLED, 매월 1일 재평가) 비율로
# 나눠 담고, 그 조합 몫 전액을 포지션 명목가치로 쓴다 - fixed/percent_balance는
# "손실액"을 고정하지만 이건 "포지션 크기"를 고정해서 손실액이 그때그때
# 손절폭에 따라 달라지는, 셋 중 가장 공격적인 모드다.
# ⚠️ 복리형(percent_balance)·가중배분형(combo_weighted) 둘 다 잔고가 늘수록
# 손실도 빠르게 커진다 - fixed로 충분히 검증한 뒤에만 전환할 것.
RISK_MODE=fixed
RISK_PERCENT_OF_BALANCE=1.0
# 잔고 비례 리스크의 상한(USDT). 0이면 상한 없음 - 잔고 조회 이상값으로
# 한 거래에 과도한 리스크가 걸리는 걸 막는 안전장치.
RISK_PERCENT_MAX_USDT=0
LEVERAGE=1
MAX_OPEN_POSITIONS=3
# 당일(UTC) 실현손실이 이 값(USDT)을 넘으면 신규 진입을 막는다(킬스위치).
# 0 이하로 두면 킬스위치 비활성. (아래 wick 엔진과 공유하는 계좌 전체 한도)
DAILY_LOSS_LIMIT_USDT=50
# 정액제 대신 정률제로 쓰려면 이 값을 0보다 크게 설정 - "현재 가용잔고의 N%"를
# 신규 진입 시도마다 다시 계산해서 그 순간의 한도로 쓴다(RISK_MODE=
# percent_balance와 같은 철학). 0보다 크면 DAILY_LOSS_LIMIT_USDT보다 우선한다.
# 잔고 조회 실패/0 이하면 DAILY_LOSS_LIMIT_USDT 고정값으로 안전하게 폴백.
DAILY_LOSS_LIMIT_PCT=0

# === 긴급 서킷브레이커 (선택, 기본 꺼짐) ===
# 위 일일 손실 한도는 "오늘 실현손익"만 보고 신규 진입만 막는다 - 이미
# 열려있는 포지션은 안 건드림. 이건 다른 층: 미실현 손익까지 포함한 지금
# 이 순간의 실제 계좌 가치가 오늘 시작 대비 이 값(%) 이상 빠지면, 열려있는
# 포지션을 전부 즉시 시장가로 강제 청산하고 신규 진입을 전부 막는다
# (data/emergency_halt.json 파일을 사람이 직접 지우기 전까지 안 풀림 -
# 일일 킬스위치처럼 자정에 자동으로 안 풀림). 플래시크래시/갭처럼 개별
# 손절 주문의 슬리피지가 감당 못 할 만큼 커지는 상황에 대한 최후 방어선.
# 0이면(기본값) 비활성.
EMERGENCY_STOP_PCT=0
# 긴급 서킷브레이커 점검 주기(초) - 기본 30초, 다른 주기적 작업과 별개로
# 빠르게 반응하도록 짧게 잡혀있다.
EMERGENCY_STOP_CHECK_INTERVAL_SECONDS=30

# === 원격 킬스위치 (선택, 기본 꺼짐) ===
# 실제 매매가 도는 서버(예: 집 PC, Oracle Cloud VM 등)에서만 설정한다.
# 모니터링용 대시보드(예: Render)가 떠 있는 주소를 가리키면, 그 대시보드의
# "원격 신규진입" 버튼으로 두 엔진의 신규 진입만 원격으로 끄고 켤 수 있다
# (이미 열린 포지션의 손절/트레일링 관리에는 영향 없음 - 일일 손실 한도
# 킬스위치와 같은 범위). 비워두면(기본값) 이 기능 자체가 없는 것처럼 동작.
REMOTE_CONTROL_URL=

# === 볼린저 꼬리터치+RSI 전략 자동매매 게이트 (켈트너와 완전히 별개, 기본 꺼짐) ===
# ⚠️ 실제 돈이 걸린 기능 - 켜기 전에 README "실계좌 자동매매 (볼린저
# 꼬리터치+RSI 전략)" 섹션을 반드시 읽을 것. 테스트넷으로 먼저 검증하고,
# 처음엔 조합 1개·작은 RISK_PER_TRADE_USDT로 시작할 것.
WICK_AUTO_TRADE_ENABLED=false
# "심볼:시간대" 콤마 구분, 예: BTCUSDT:15m
WICK_AUTO_TRADE_WHITELIST=
# 이 전략이 검증된 시간대만 스캔한다 - 대시보드/켈트너용 TIMEFRAMES와는 별개.
WICK_TIMEFRAMES=15m,5m

# === 조합별 신뢰도 기반 리스크 가중치 (선택, 기본 꺼짐) ===
# 매월 1일 00:05 UTC에 화이트리스트의 각 조합(심볼:시간대)을 과거
# COMBO_WEIGHTS_LOOKBACK_DAYS일 데이터로 재평가해서(거래당 평균수익률÷
# 표준편차가 높을수록 신뢰도 높음), 신규 진입 리스크 금액에 곱할 가중치를
# 다시 계산한다(상한 40%/하한 10%). 꺼져 있으면(기본값) 모든 조합이
# RISK_PER_TRADE_USDT를 지금까지처럼 동일하게 쓴다.
WICK_RELIABILITY_WEIGHTING_ENABLED=false
COMBO_WEIGHTS_LOOKBACK_DAYS=210

# === 조합별 비대칭 CPPI 사이징 오버레이 (선택, 기본 꺼짐) ===
# RISK_MODE=combo_weighted에서만 의미가 있다. 조합마다 독립적으로 "자기
# 자신의 상대적 고점 대비 드로다운"을 추적해서, 신고점 근처면 명목가치를
# 1.2배까지 증액하고 드로다운 중이면 0.2배까지 축소한다(매월 1일 가중치
# 재계산과 같은 시점에 전 조합 리밸런싱 - 상태를 1.0으로 리셋).
# 2026-01~11월 실데이터 검증: 평균 성과는 개선되지만, 증액(1.2배) 상태에서
# 큰 슬리피지가 겹치면 꺼져있을 때보다 그 거래 손실이 더 커질 수 있다는
# 꼬리 리스크가 있음 - README "실계좌 자동매매" 섹션 필독.
WICK_CPPI_ENABLED=false

# === 텔레그램 알림 (선택, 비워두면 알림 없이 조용히 스킵) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === 실시간 차트 대시보드 ===
DASHBOARD_TIMEFRAMES=15m,1h,4h,1d
# 캔들/현재가/24h통계를 /ws/live로 push하는 주기(초)
LIVE_POLL_INTERVAL_SECONDS=3
TICKER24H_POLL_INTERVAL_SECONDS=30

# === 전략 페이지 백테스트 학습/검증 구간 (build_stats.py가 씀) ===
BACKTEST_TRAIN_START=2021-07-01
BACKTEST_TRAIN_END=2025-02-01
# 비워두면 "지금"까지를 검증 구간으로 사용
BACKTEST_VALIDATION_END=

# === 인프라 ===
SCAN_INTERVAL_SECONDS=60
POSITION_WATCH_INTERVAL_SECONDS=300
# /strategy, /lab 백테스트 성적표 3종을 서버가 스스로 다시 계산하는 주기(시간)
STATS_REFRESH_INTERVAL_HOURS=24
# "검증됨" 등급 전략 백테스트에 반영하는 거래 1건당 왕복 수수료(%) - 바이낸스
# 선물 테이커 편도 0.05% x 2회 가정. VIP/메이커/BNB 할인 적용 시 낮출 수 있음
TAKER_FEE_PCT_ROUNDTRIP=0.1
CORS_ORIGINS=*
# DATABASE_URL=sqlite:////app/data/bot.db

# === 대시보드 접근 제한 (선택, 기본 꺼짐) ===
# 실계좌 매매 현황(/trading 등)이 공개 도메인에 떠 있으면 누구나 볼 수 있음.
# 둘 다 채워야 HTTP Basic Auth가 켜진다 - 하나라도 비어있으면(기본값) 지금까지와
# 동일하게 인증 없이 열린다. Render라면 반드시 Environment 화면에서만 설정할 것.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# === 실계좌 누적 수익률 기준점 (선택, 기본 꺼짐) ===
# 실계좌 자동매매를 시작한 시점의 지갑 잔고(USDT)를 한 번 적어두면, /trading
# 페이지의 "실계좌 실시간" 섹션이 지금 잔고 대비 몇 % 벌었는지 계산해서
# 보여준다. 0이면(기본값) 계산 자체를 하지 않고 표시도 안 한다.
REAL_ACCOUNT_STARTING_BALANCE_USDT=0
